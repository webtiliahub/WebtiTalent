# ───────────── Base de datos ─────────────
# PostgreSQL (Neon en producción; clone local en desarrollo)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# ───────────── Autenticación ─────────────
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ───────────── Cron (recordatorios automáticos) ─────────────
CRON_SECRET="genera-uno-con: openssl rand -base64 32"

# ───────────── URL pública (correos: logo y botones) ─────────────
# En producción SIEMPRE explícita: sin ella los botones de los correos apuntan a localhost.
# APP_URL="https://webtitalent.vercel.app"

# ───────────── Push (PWA) ─────────────
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ccalmet@webtilia.com"

# ───────────── Correo — elegir UN transporte ─────────────
# Opción A: Resend (transporte de producción de WebtiTalent, dominio webtilia.com verificado)
# RESEND_API_KEY="re_..."
# RESEND_FROM="WebtiTalent <no-reply@webtilia.com>"

# Opción B: SMTP (si algún día se migra a un buzón propio). Si SMTP_HOST está definida, manda SMTP.
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_USER="notificaciones@webtilia.com"
# SMTP_PASS="contraseña-o-app-password"
# SMTP_FROM="WebtiTalent <notificaciones@webtilia.com>"

# Sin ninguna de las dos: en desarrollo los correos se imprimen a consola; en producción falla.
