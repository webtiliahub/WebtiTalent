# ───────────── Base de datos ─────────────
# PostgreSQL (Neon en producción; clone local en desarrollo)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# ───────────── Autenticación ─────────────
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3001"

# ───────────── Cron (recordatorios automáticos) ─────────────
CRON_SECRET="genera-uno-con: openssl rand -base64 32"

# ───────────── URL pública (correos: logo y botones) ─────────────
# Opcional: en Vercel se deriva sola de VERCEL_PROJECT_PRODUCTION_URL
# APP_URL="https://plataforma.hunter.com.pe"

# ───────────── Correo — elegir UN transporte ─────────────
# Opción A (go-live): SMTP del Office365 de Hunter TI. Si SMTP_HOST está definida, manda SMTP.
# La cuenta debe tener «SMTP autenticado» habilitado en el admin de Microsoft 365 y, si usa MFA,
# una contraseña de aplicación. Límites de O365: ~30 mensajes/minuto, 10.000 destinatarios/día.
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_USER="notificaciones@hunter.com.pe"
# SMTP_PASS="contraseña-o-app-password"
# SMTP_FROM="Hunter 360 <notificaciones@hunter.com.pe>"

# Opción B (puente de desarrollo): Resend
# RESEND_API_KEY="re_..."
# RESEND_FROM="Hunter 360 <notificaciones@dominio-verificado.com>"

# Sin ninguna de las dos: en desarrollo los correos se imprimen a consola; en producción falla.
